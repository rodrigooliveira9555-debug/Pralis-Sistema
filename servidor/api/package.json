    "@fastify/cors": "^11.1.0",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "11.1.0",
    "@fastify/static": "^8.2.0",
    "better-auth": "^1.6.11",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.6.2",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/pg": "^8.15.6"
