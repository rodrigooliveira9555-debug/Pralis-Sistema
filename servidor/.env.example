# Copie para .env e ajuste. Nunca versione o .env.
NODE_ENV=development
DATABASE_URL=postgresql://cicluz:cicluz@localhost:5545/cicluz
# Mínimo de 32 caracteres. Em produção, gere um valor aleatório e guarde só no painel do servidor.
BETTER_AUTH_SECRET=troque-por-um-segredo-com-pelo-menos-32-caracteres
# Endereço público do site (o mesmo onde o navegador abre o entrar.html).
AUTH_BASE_URL=http://localhost:4200
# Origens do site separadas por vírgula (produção: o domínio do Vercel).
WEB_ORIGINS=http://localhost:4200
PORT=4200
HOST=0.0.0.0
# 1 = a API também entrega o site de dist/ (desenvolvimento local, ou servidor único).
SERVIR_SITE=1
